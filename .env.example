# Formspree form endpoint (Contact page).
# Create a form at https://formspree.io, set its destination email in the
# Formspree dashboard, then paste the endpoint URL below.
# The form ID is safe to expose client-side — it is not the destination
# email address, which is only configured in the Formspree dashboard.
VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/your_form_id

# Supabase project (Join page applications -> private /applications dashboard).
# Create a project at https://supabase.com, run the setup SQL provided
# separately to create the `applications` table + security policies, add
# yourself as an Auth user, then paste your project's URL and anon
# (public) key below. The anon key is safe to expose client-side — Row
# Level Security policies restrict it to insert-only for everyone except
# your authenticated account, which can also read.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key
